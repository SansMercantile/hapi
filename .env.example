# HAPI is a pure client-side SPA -- no backend server, no API keys needed.
# (If a real AI feature is added later, it should call AWS Bedrock from a
# small Express server, same pattern as ptah/shango/hathor -- never call
# Bedrock/any model provider directly from the browser.)

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# Base URL of the standalone backend API (constellation/<product>-backend), deployed
# independently. The frontend prefixes all /api calls with this.
VITE_API_BASE_URL="https://api.hapi.sansmercantile.com"


